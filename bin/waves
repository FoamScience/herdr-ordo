#!/usr/bin/env bash
# Progressive review, opt in with WAVES=1: the working tree is recorded as a
# wave (`ordo wave`) each time the agent finishes a turn — herdr sees it go
# from working back to idle. bin/pane records the first one, before ordo
# starts, so a review of `wave/0..wave/last` always has it. `ordo
# wave/2..wave/3` then reviews one turn. Runs beside the review pane and ends
# with it, or when the agent's pane goes away.
set -u
root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
. "$root/bin/config"

agent="${AGENT_PANE:-${ORDO_ORIGIN_PANE:-}}"
[ -n "$agent" ] || exit 0
# a blocking `herdr agent wait` is a child of its own: take it down too
trap 'kill $(jobs -p) 2>/dev/null; exit 0' TERM INT

while :; do
  "$H" agent wait "$agent" --until working >/dev/null 2>&1 &
  wait $! || exit 0
  "$H" agent wait "$agent" --until idle --until done >/dev/null 2>&1 &
  wait $! || exit 0
  # a Claude Code agent's transcript says what the turn was asked and what
  # it answered; ordo keeps that in the wave
  session=$("$H" agent get "$agent" 2>/dev/null |
    jq -r 'select(.result.agent.agent == "claude") | .result.agent.agent_session.value // empty' 2>/dev/null)
  if [ -n "$session" ]; then
    "$ORDO_BIN" wave --claude "$session" >/dev/null 2>&1 || "$ORDO_BIN" wave >/dev/null 2>&1
  else
    "$ORDO_BIN" wave >/dev/null 2>&1
  fi
done
